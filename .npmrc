# pnpm configuration for CI/CD builds
# https://pnpm.io/npmrc

# Allow build scripts from trusted packages (sharp, SWC, etc.)
# Run `pnpm approve-builds` locally to interactively approve packages
# Or list them explicitly:
onlyBuiltDependencies=true

# Enable hoisting for Next.js compatibility
shamefully-hoist=true
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*

# Strict peer dependencies (recommended for CI stability)
strict-peer-dependencies=false

# Enable lockfile for reproducible builds
frozen-lockfile=false
