# ===========================================
# FIELD Protocol Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values

# -----------------------------------------
# Frontend Configuration
# -----------------------------------------
# URL to the Dojo backend (Dialectic Engine)
# For local development: http://localhost:7411
# For production: Your Cloudflare Tunnel URL
NEXT_PUBLIC_DOJO_URL=http://localhost:7411

# -----------------------------------------
# Dojo (Dialectic Engine) Configuration
# -----------------------------------------
# Port for the Hono server
DOJO_PORT=7411

# Notion Integration (for Chronicle persistence)
NOTION_API_KEY=
MCP_NOTION_TOKEN=

# -----------------------------------------
# Recognition Service Configuration
# -----------------------------------------
# Port for the Recognition API
RECOGNITION_PORT=9630

# OpenAI API Key (for document intelligence)
OPENAI_API_KEY=

# -----------------------------------------
# Feature Flags
# -----------------------------------------
# Enable debug logging for geometric alignment
FIELD_DEBUG=false

# Enable Chronicle writing to local filesystem
CHRONICLE_LOCAL=true
